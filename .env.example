# Filled in automatically on Vercel when you connect Neon (Postgres) and Blob storage.
# Locally: `npx vercel env pull .env.local`
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Break-glass password for /admin. Day to day, tutors use the rotating password posted to Discord.
ADMIN_PASSWORD=

# Discord webhook (tutors-only channel). Also required for rotating the tutor password.
DISCORD_WEBHOOK_URL=

# Optional: send some alerts to their own channels. Anything left out goes to
# DISCORD_WEBHOOK_URL. Leave unused ones out rather than blank.
# DISCORD_WEBHOOK_POSTS=        new questions and answers
# DISCORD_WEBHOOK_MODERATION=   reports, auto-hides, posts waiting for review
# DISCORD_WEBHOOK_PASSWORD=     new tutor password (tutors-only channel!)
# DISCORD_WEBHOOK_CHECKINS=     daily check-in summary
# DISCORD_WEBHOOK_TICKETS=      bug reports and tickets

# Optional: connections per server instance. Leave it out to use the default (5).
# DB_POOL_MAX=5

# Optional: the URL printed on the /qr poster and in Discord links (defaults to the current host).
NEXT_PUBLIC_SITE_URL=
