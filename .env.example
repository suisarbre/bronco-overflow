# Filled in automatically on Vercel when you connect Neon (Postgres) and Blob storage.
# Locally: `npx vercel env pull .env.local`
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Password for /admin (lets tutors delete any post). Pick something long.
ADMIN_PASSWORD=

# Optional: Discord webhook for new posts, reports, and auto-hides.
DISCORD_WEBHOOK_URL=

# Optional: the URL printed on the /qr poster (defaults to the current host).
NEXT_PUBLIC_SITE_URL=
